# Todas las variables son opcionales. Sin ninguna, la app corre 100 % local, sin tokens ni internet.

# Modo de consulta: "reglas" (por defecto, sin IA) u "ollama" (agente IA local, opcional).
MODO_AGENTE=reglas

# Solo si MODO_AGENTE=ollama. Requiere Ollama instalado y un modelo con soporte de herramientas.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=llama3.1

# Fecha de referencia para calcular atrasos. Fija para que la demo sea repetible.
FECHA_REFERENCIA=2026-10-31

# Carpetas (relativas a la raíz del proyecto).
DATOS_DIR=data/synthetic
GENERADO_DIR=data/generated
