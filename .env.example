# Todas las variables son opcionales. Sin ninguna, la app corre 100 % local, sin tokens ni internet.

# Modo de consulta: "reglas" (por defecto, sin IA) u "ollama" (agente IA local, opcional).
MODO_AGENTE=reglas

# Solo si MODO_AGENTE=ollama. Requiere Ollama instalado y un modelo con soporte de herramientas.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=llama3.1

# Fecha de referencia para calcular atrasos. Fija para que la demo sea repetible.
FECHA_REFERENCIA=2026-10-31

# Carpetas (relativas a la raíz del proyecto).
DATOS_DIR=data/synthetic
GENERADO_DIR=data/generated
SUBIDOS_DIR=data/uploads

# Sincronización local: 60 segundos; usa 0 para desactivar la tarea periódica.
SINCRONIZACION_INTERVALO_SEGUNDOS=60

# Umbrales de vigencia en días por área/fuente; default se usa si no hay clave específica.
# Se mide desde la última sincronización exitosa, no desde la fecha del dato ni el mtime.
VIGENCIA_DIAS_POR_FUENTE={"default":7,"fiscalizacion":1}

# Acceso de demostración. Cambia la contraseña antes de cualquier despliegue.
APP_USERNAME=admin
APP_PASSWORD=12345678

# Actívalo cuando la app esté detrás de HTTPS.
COOKIE_SECURE=0
